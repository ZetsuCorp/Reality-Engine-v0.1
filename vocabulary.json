#include "BPE.h"

#include <limits>

namespace rare::tokenizer {

std::size_t BytePairHash::operator()(const BytePair& pair) const noexcept {
    const std::size_t h1 = std::hash<std::string>{}(pair.left);
    const std::size_t h2 = std::hash<std::string>{}(pair.right);
    return h1 ^ (h2 + static_cast<std::size_t>(0x9e3779b97f4a7c15ULL) + (h1 << 6) + (h1 >> 2));
}

void BPE::set_merges(MergeMap merges) {
    merges_ = std::move(merges);
}

const BPE::MergeMap& BPE::merges() const noexcept {
    return merges_;
}

bool BPE::best_merge(const std::vector<std::string>& symbols,
                     std::size_t& position,
                     BytePair& pair) const {
    std::size_t best_rank = std::numeric_limits<std::size_t>::max();
    bool found = false;

    for (std::size_t i = 0; i + 1 < symbols.size(); ++i) {
        BytePair candidate{symbols[i], symbols[i + 1]};
        const auto it = merges_.find(candidate);
        if (it != merges_.end() && it->second < best_rank) {
            best_rank = it->second;
            position = i;
            pair = std::move(candidate);
            found = true;
        }
    }

    return found;
}

std::vector<std::string> BPE::apply(const std::vector<std::string>& input) const {
    std::vector<std::string> symbols = input;

    while (symbols.size() > 1) {
        std::size_t position = 0;
        BytePair pair;
        if (!best_merge(symbols, position, pair)) {
            break;
        }

        symbols[position] += symbols[position + 1];
        symbols.erase(symbols.begin() + static_cast<std::ptrdiff_t>(position + 1));
    }

    return symbols;
}

} // namespace rare::tokenizer
